# Bikeathon dev docker-compose env vars.
# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
#
# STRIPE_WEBHOOK_SECRET is intentionally NOT set here — the stripe-cli container
# captures the webhook signing secret at runtime and writes it to a shared volume;
# the app entrypoint reads it from there before starting `next dev`.

# Stripe
# The stripe-cli container is locked to whichever account this key belongs to,
# regardless of the host's `stripe login` state.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional belt-and-suspenders account guard. If set, the stripe-cli container
# aborts on startup unless STRIPE_SECRET_KEY belongs to this account.
# Find your account ID at https://dashboard.stripe.com (top-left dropdown).
# EXPECTED_STRIPE_ACCOUNT_ID=acct_

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
